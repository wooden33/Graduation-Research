\@writefile{toc}{\contentsline {section}{\numberline {3}Methodology}{3}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Overview}{3}{subsection.3.1}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{ \textsc  {CogPath}{} is a coverage-guided iterative framework for automated unit test generation, illustrated in Figure\nonbreakingspace \ref {fig:overview}. Given a method under test and an initial test suite, \textsc  {CogPath}{} builds the CFG, enumerates feasible paths, collects dynamic coverage feedback to identify uncovered branches, and then enters an iterative loop to systematically handle these branches. Each iteration proceeds in three steps. First, the framework selects an uncovered path and applies \textit  {Constraints-Hints} to extract explicit branch conditions as structured hints for the generation prompt. Second, if coverage has stagnated, \textit  {Backward Slicing} replaces the full method body with the minimal set of branch-relevant statements. Third, the LLM generates candidate tests, which are compiled and executed; passing tests are merged into the suite, and failing tests enter a repair phase. Coverage is then re-measured to guide the next iteration. The loop terminates when target coverage is reached, the iteration budget is exhausted, or coverage fails to improve for a configurable number of consecutive iterations. }}{3}{section*.8}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added: \truncate {\Changestruncatewidth }{In the following sections, we will provide detailed introductions about \textsc  {CogPath}{}.}}{3}{section*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the coverage-guided test generation framework.}}{4}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{4}{Overview of the coverage-guided test generation framework}{figure.caption.7}{}}
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{ \textsc  {CogPath}{} is a coverage-guided iterative framework for automated unit test generation. The overall workflow is illustrated in Figure\nonbreakingspace \ref {fig:overview}. Starting from the method under test (MUT) and an initial test suite (possibly empty), the framework performs static analysis to construct the control-flow graph and enumerate feasible execution paths. Dynamic execution feedback is then collected to identify uncovered lines and branches.}}{4}{section*.10}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{ To efficiently exercise uncovered paths, \textsc  {CogPath}{} integrates two complementary mechanisms. First, a \textit  {Constraints-Hints} module derives explicit branch conditions along a selected path and exposes them as structured hints in the test generation prompt, making hidden input requirements visible to the LLM. Second, a \textit  {Backward Slicing} module is triggered when coverage improvement stagnates, extracting the minimal set of statements that influence a stubborn uncovered path and supplying them as targeted context.}}{4}{section*.11}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted: \truncate {\Changestruncatewidth }{ Each iteration proceeds as follows. The framework selects uncovered paths, optionally derives constraint hints, and invokes the test generation LLM to produce candidate tests. These candidates are compiled and executed to validate their correctness. Failing tests are optionally forwarded to a repair phase. Successfully validated tests are incorporated into the test suite and coverage is re-measured, closing the feedback loop. The process terminates when the target coverage is reached, the iteration budget is exhausted, or coverage ceases to improve for a configurable number of iterations.}}{4}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Constraints-Hints for Path Solving}{4}{subsection.3.2}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced: \truncate {\Changestruncatewidth }{ \textit  {Constraints-Hints} addresses the implicit precondition problem by decoupling constraint inference from test synthesis. Rather than asking the LLM to simultaneously reason about reachability and generate code, we introduce a dedicated constraint-solving step that makes branch preconditions explicit before generation begins. }}{4}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Path formulation.}{4}{section*.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Integration.}{4}{section*.15}\protected@file@percent }
